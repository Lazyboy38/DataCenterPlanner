<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore">

    <DropShadowEffect x:Key="PanelShadowEffect"
                      BlurRadius="18"
                      ShadowDepth="0"
                      Opacity="0.25"/>

    <Style TargetType="Border" x:Key="PanelBorderStyle">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Effect" Value="{StaticResource PanelShadowEffect}"/>
    </Style>
</ResourceDictionary>