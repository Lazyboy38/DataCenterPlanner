<Window x:Class="DataCenterPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DataCenterPlanner"
        Height="1111"
        Width="1240"
        MinWidth="1100"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
        

    <ScrollViewer x:Name="MainScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource HeaderGradient}"
                    CornerRadius="22"
                    Padding="26"
                    Effect="{StaticResource PanelShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="DATA CENTER PLANNER"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Rack planning, server sizing, and topology overview for Data Center"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#18202B"
                            BorderBrush="#3E9EE0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,8"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="CURRENT BUILD"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="BuildVersionTextBlock"
                                       Text="v0.0.0"
                                       Foreground="{StaticResource AccentBrushSoft}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Input Parameters"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Grid.Row="1"
                                   Text="Choose a planning mode and enter the requested IOPS for each server family."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Planning Mode"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="PlanningModeComboBox"
                                      SelectedIndex="0"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}">
                                <ComboBoxItem Content="Balanced Racks"/>
                                <ComboBoxItem Content="Minimum Racks"/>
                            </ComboBox>

                            <Border Background="#202734"
                                    BorderBrush="#35516A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Network Planning"
                                               Foreground="{StaticResource AccentBrushSoft}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="RedundancyCheckBox"
                                              Content="Plan with redundancy"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                    BorderBrush="#35516A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Allowed Server Types"
                                               Foreground="{StaticResource AccentBrushSoft}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="Allow12kServersCheckBox"
                                              Content="Allow 12k Server"
                                              IsChecked="True"
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              Margin="0,0,0,6"/>

                                    <CheckBox x:Name="Allow5kServersCheckBox"
                                              Content="Allow 5k Server"
                                              IsChecked="True"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                    BorderBrush="#6B5830"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SystemX IOPS"
                                               Foreground="{StaticResource SystemXBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="SystemXIopsTextBox"
                                             Margin="0"
                                             Text="100000"
                                             BorderBrush="{StaticResource SystemXBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                    BorderBrush="#2E5E85"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="RISC IOPS"
                                               Foreground="{StaticResource RiscBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="RiscIopsTextBox"
                                             Margin="0"
                                             Text="50000"
                                             BorderBrush="{StaticResource RiscBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                    BorderBrush="#7050A8"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Mainframe IOPS"
                                               Foreground="{StaticResource MainframeBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="MainframeIopsTextBox"
                                             Margin="0"
                                             Text="50000"
                                             BorderBrush="{StaticResource MainframeBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                    BorderBrush="#2F8A5E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="GPU IOPS"
                                               Foreground="{StaticResource GpuBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="GpuIopsTextBox"
                                             Margin="0"
                                             Text="40000"
                                             BorderBrush="{StaticResource GpuBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="4"
                                x:Name="CalculateButton"
                                Content="Calculate Plan"
                                Click="CalculateButton_Click"/>

                        <Border Grid.Row="6"
                                Margin="0,18,0,0"
                                Background="{StaticResource PanelBrushSecondary}"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Hardware Baseline"
                                           Foreground="{StaticResource AccentBrushSoft}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Rack: 47U"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="Switch: 1U"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="12k Server: 7U"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="5k Server: 3U"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="Global Main Rack: exactly 1 extra switch"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}">
                    <TabControl Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource ModernTabControlStyle}"
                                ItemContainerStyle="{StaticResource ModernTabItemStyle}">

                        <TabItem Header="Planner">
                            <Grid Margin="12,10,12,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                           Text="Planning Result"
                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Grid.Row="1"
                           Text="Calculated rack layout, server count, and switch distribution"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,6"/>

                                <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,0">
                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Total Racks"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                                            <TextBlock Text="{Binding TotalRacks, Mode=OneWay}"
                                       Foreground="{StaticResource AccentBrushSoft}"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Total Switches"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                                            <TextBlock Text="{Binding TotalSwitches, Mode=OneWay}"
                                       Foreground="{StaticResource AccentBrushSoft}"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Target IOPS"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                                            <TextBlock Text="{Binding TotalTargetIops, Mode=OneWay, StringFormat={}{0:N0}}"
                                       Foreground="{StaticResource AccentBrushSoft}"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Global Main Rack"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                                            <TextBlock Text="{Binding GlobalMainRackText, Mode=OneWay}"
                                       Foreground="{StaticResource AccentBrushSoft}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Rack Switches"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                                            <TextBlock Text="{Binding Network.RackSwitchCount, Mode=OneWay}"
                                       Foreground="#4AAEFF"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="QSFP Modules"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                                            <TextBlock Text="{Binding Network.QsfpModuleCount, Mode=OneWay}"
                                       Foreground="#57D68D"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="QSFP Packs"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                                            <TextBlock Text="{Binding Network.QsfpPackCount, Mode=OneWay}"
                                       Foreground="#F2C94C"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="RJ45 SFP Packs"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                                            <TextBlock Text="{Binding Network.Rj45SfpPackCount, Mode=OneWay}"
                                       Foreground="#F2994A"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <ScrollViewer Grid.Row="5"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="ResultScrollViewer_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding CategoryCards, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#202734"
                                        BorderBrush="{Binding AccentColorHex, Mode=OneWay}"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="16"
                                        Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Category, Mode=OneWay}"
                                                   Foreground="{Binding AccentColorHex, Mode=OneTime}"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>

                                                        <WrapPanel Margin="0,10,0,14">
                                                            <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Racks" Foreground="#8AA4B8" FontSize="11"/>
                                                                    <TextBlock Text="{Binding RackCount, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="12k Servers" Foreground="#8AA4B8" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Total12kServers, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="5k Servers" Foreground="#8AA4B8" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Total5kServers, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Switches" Foreground="#8AA4B8" FontSize="11"/>
                                                                    <TextBlock Text="{Binding TotalSwitches, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="Planned IOPS" Foreground="#8AA4B8" FontSize="11"/>
                                                                    <TextBlock Text="{Binding PlannedIops, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="White" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </WrapPanel>

                                                        <ItemsControl ItemsSource="{Binding Racks, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#161C25"
                                                            CornerRadius="10"
                                                            Padding="12"
                                                            Margin="0,0,0,8">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="10"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>

                                                                            <Grid Grid.Row="0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackPanel>
                                                                                    <TextBlock FontWeight="Bold" Foreground="White">
                                                                        <Run Text="Rack "/>
                                                                        <Run Text="{Binding RackNumber, Mode=OneWay}"/>
                                                                        <Run Text="{Binding MainRackLabel, Mode=OneWay}"/>
                                                                                    </TextBlock>

                                                                                    <TextBlock Foreground="#B8D4EA" Margin="0,4,0,0">
                                                                        <Run Text="{Binding Count12kServers, Mode=OneWay}"/>
                                                                        <Run Text=" x 12k, "/>
                                                                        <Run Text="{Binding Count5kServers, Mode=OneWay}"/>
                                                                        <Run Text=" x 5k, "/>
                                                                        <Run Text="{Binding TotalDisplayedSwitches, Mode=OneWay}"/>
                                                                        <Run Text=" switch(es)"/>
                                                                                    </TextBlock>
                                                                                </StackPanel>

                                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                                    <TextBlock Text="{Binding TotalIops, Mode=OneWay, StringFormat={}{0:N0} IOPS}"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Right"/>
                                                                                    <TextBlock Foreground="#8AA4B8"
                                                                               HorizontalAlignment="Right">
                                                                        <Run Text="{Binding UsedUnits, Mode=OneWay}"/>
                                                                        <Run Text="/47U used, "/>
                                                                        <Run Text="{Binding FreeUnits, Mode=OneWay}"/>
                                                                        <Run Text="U free"/>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="230"/>
                                                                                    <ColumnDefinition Width="12"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <Border Grid.Column="0"
                                                                        Height="12"
                                                                        Background="#0E141C"
                                                                        BorderBrush="#263445"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        VerticalAlignment="Center">
                                                                                    <Grid>
                                                                                        <Border HorizontalAlignment="Left"
                                                                                Width="{Binding UsageBarWidth, Mode=OneWay}"
                                                                                Background="{Binding AccentColorHex, Mode=OneWay}"
                                                                                CornerRadius="6"
                                                                                Height="12"/>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding UsagePercentText, Mode=OneWay}"
                                                                           Foreground="{Binding AccentColorHex, Mode=OneWay}"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Grid.Row="7"
                                    Background="#202734"
                                    BorderBrush="#35516A"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16"
                                    Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Shopping Summary"
                                   Foreground="{StaticResource AccentBrushSoft}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                                        <UniformGrid Columns="4">
                                            <Border Background="#1A212C"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="Compute Cost"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding Shopping.ComputeCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                               Foreground="#F2C94C"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#1A212C"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="Infrastructure Cost"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding Shopping.InfrastructureCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                               Foreground="#4AAEFF"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#1A212C"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="Module Cost"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding Shopping.ModuleCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                               Foreground="#57D68D"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="#1A212C"
                                    CornerRadius="10"
                                    Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="Total Cost"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding Shopping.TotalCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                               Foreground="{StaticResource AccentBrushSoft}"
                                               FontSize="22"
                                               FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Rack View">
                            <ScrollViewer x:Name="RackViewScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="RackViewScrollViewer_PreviewMouseWheel">
                                <StackPanel Margin="12,10,12,12">
                                    <TextBlock Text="Rack Layout"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Visual slot layout for all planned racks"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,0,0,14"/>

                                    <ItemsControl ItemsSource="{Binding Racks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="260"
                                                        Background="#202734"
                                                        BorderBrush="{Binding AccentColorHex}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="12"
                                                        Margin="0,0,14,14">
                                                    <StackPanel>

                                                        <!-- Header -->
                                                        <Border Background="#161C25"
                                                                CornerRadius="10,10,0,0"
                                                                Padding="10,8">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding RackTitle}"
                                                                               Foreground="White"
                                                                               FontWeight="Bold"
                                                                               FontSize="11"/>
                                                                    <TextBlock Text="{Binding UsageSummary}"
                                                                               Foreground="#8AA4B8"
                                                                               FontSize="10"
                                                                               HorizontalAlignment="Right"
                                                                               DockPanel.Dock="Right"/>
                                                                </DockPanel>
                                                                <Border Height="4"
                                                                        Background="#0E141C"
                                                                        CornerRadius="3"
                                                                        Margin="0,5,0,0">
                                                                    <Grid>
                                                                        <Border HorizontalAlignment="Left"
                                                                                Width="{Binding VisualBarWidth}"
                                                                                Background="{Binding AccentColorHex}"
                                                                                CornerRadius="3"
                                                                                Height="4"/>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Rack slots -->
                                                        <ItemsControl ItemsSource="{Binding Slots}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Height="{Binding DisplayHeight}"
                                                                            Background="{Binding ColorHex}"
                                                                            ClipToBounds="True"
                                                                            BorderBrush="#2A3545"
                                                                            BorderThickness="0,0,0,1">
                                                                        <Grid Margin="6,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="44"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="26"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding ULabel}"
                                                                                       FontSize="{Binding LabelFontSize}"
                                                                                       Foreground="{Binding LabelColorHex}"
                                                                                       Opacity="0.6"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Name}"
                                                                                       FontSize="{Binding LabelFontSize}"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{Binding LabelColorHex}"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="6,0,0,0"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding HeightLabel}"
                                                                                       FontSize="{Binding LabelFontSize}"
                                                                                       Foreground="{Binding LabelColorHex}"
                                                                                       Opacity="0.6"
                                                                                       HorizontalAlignment="Right"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Category legend -->
                                                        <Border Background="#161C25"
                                                                CornerRadius="0,0,10,10"
                                                                Padding="10,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="8"
                                                                         Height="8"
                                                                         Fill="{Binding AccentColorHex}"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding CategoryDisplayName}"
                                                                           Foreground="#8AA4B8"
                                                                           FontSize="10"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Shopping">
                            <ScrollViewer x:Name="ShoppingScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ShoppingScrollViewer_PreviewMouseWheel">
                                <StackPanel Margin="12,10,12,12">
                                    <TextBlock Text="Shopping List"
                               Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock Text="Required hardware grouped by category"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,14"/>

                                    <ItemsControl ItemsSource="{Binding Shopping.Categories, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#202734"
                                        BorderBrush="{Binding AccentColorHex, Mode=OneWay}"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="16"
                                        Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   Foreground="{Binding AccentColorHex, Mode=OneWay}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12"/>

                                                        <DataGrid ItemsSource="{Binding Items, Mode=OneWay}"
                                                  Style="{StaticResource ModernDataGridStyle}"
                                                  HeadersVisibility="Column"
                                                  MinHeight="80"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                            <DataGrid.RowStyle>
                                                                <Style TargetType="DataGridRow">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBought}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.35"/>
                                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </DataGrid.RowStyle>
                                                            <DataGrid.Columns>
                                                                <DataGridTemplateColumn Header="✓" Width="36">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding IsBought, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTextColumn Header="Item"
                                                                    Binding="{Binding Name}"
                                                                    Width="*"/>
                                                                <DataGridTextColumn Header="Qty"
                                                                    Binding="{Binding Quantity}"
                                                                    Width="80"/>
                                                                <DataGridTextColumn Header="Unit Price"
                                                                    Binding="{Binding UnitPrice, StringFormat={}{0:N0}$}"
                                                                    Width="120"/>
                                                                <DataGridTextColumn Header="Total"
                                                                    Binding="{Binding TotalPrice, StringFormat={}{0:N0}$}"
                                                                    Width="120"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>

                                                        <Border Background="#1A212C"
                                                CornerRadius="10"
                                                Padding="12"
                                                HorizontalAlignment="Right"
                                                MinWidth="180">
                                                            <StackPanel>
                                                                <TextBlock Text="Category Total"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding TotalPrice, Mode=OneWay, StringFormat={}{0:N0}$}"
                                                           Foreground="{Binding AccentColorHex, Mode=OneWay}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Grand Total"
                                       Foreground="{StaticResource AccentBrushSoft}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Shopping.TotalCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                       Foreground="{StaticResource AccentBrushSoft}"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Background="#202734"
                    CornerRadius="12"
                    Padding="12,8">
                <DockPanel>
                    <TextBlock Text="Inspired by the Data Center in-game color palette"
                               Foreground="{StaticResource MutedTextBrush}"
                               DockPanel.Dock="Left"/>

                    <TextBlock Text="WPF Prototype"
                               Foreground="{StaticResource AccentBrushSoft}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="4"
                    Background="#202734"
                    CornerRadius="12"
                    Padding="12,8">
                <DockPanel>
                    <TextBlock Text="Inspired by the Data Center in-game color palette"
                               Foreground="{StaticResource MutedTextBrush}"
                               DockPanel.Dock="Left"/>

                    <TextBlock Text="WPF Prototype"
                               Foreground="{StaticResource AccentBrushSoft}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>