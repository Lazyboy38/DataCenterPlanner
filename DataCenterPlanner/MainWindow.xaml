<Window x:Class="DataCenterPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DataCenterPlanner"
        Height="900"
        Width="1240"
        MinWidth="1100"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="#394150"
        Foreground="#EAF4FF">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#394150"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#2A3140"/>
        <SolidColorBrush x:Key="PanelBrushSecondary" Color="#222936"/>
        <SolidColorBrush x:Key="InputBrush" Color="#1B212C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2FA8FF"/>
        <SolidColorBrush x:Key="AccentBrushSoft" Color="#78C8FF"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EAF4FF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8D4EA"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8AA4B8"/>
        <SolidColorBrush x:Key="BorderBrushBlue" Color="#4AAEFF"/>

        <SolidColorBrush x:Key="SystemXBrush" Color="#F2C94C"/>
        <SolidColorBrush x:Key="RiscBrush" Color="#4AAEFF"/>
        <SolidColorBrush x:Key="MainframeBrush" Color="#BB86FC"/>
        <SolidColorBrush x:Key="GpuBrush" Color="#57D68D"/>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Box"
                            Width="18"
                            Height="18"
                            CornerRadius="4"
                            Background="#18202B"
                            BorderBrush="#4AAEFF"
                            BorderThickness="1.2"
                            VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                              Visibility="Collapsed"
                              Stroke="White"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 3 9 L 7 13 L 14 5"/>
                            </Border>

                            <ContentPresenter Grid.Column="2"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrushSoft}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                        BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                        CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="1"
                                Background="#243041"
                                CornerRadius="0,10,10,0">
                                    <Path HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="{StaticResource AccentBrushSoft}"
                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrushSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrushSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBlue}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  Style="{StaticResource ModernComboBoxToggleButton}"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  ClickMode="Press"/>

                            <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Margin="12,0,42,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border Margin="0,4,0,0"
                                Background="#1B212C"
                                BorderBrush="{StaticResource BorderBrushBlue}"
                                BorderThickness="1"
                                CornerRadius="10">
                                    <ScrollViewer Margin="4"
                                          SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="#1B212C"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2C4056"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0F1822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2B3140" Offset="0"/>
            <GradientStop Color="#222936" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="PanelShadowEffect"
                          BlurRadius="18"
                          ShadowDepth="0"
                          Opacity="0.25"/>

        <Style TargetType="Border" x:Key="PanelBorderStyle">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Effect" Value="{StaticResource PanelShadowEffect}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabelStyle">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBlue}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrushSoft}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBlue}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#35516A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2FA8FF"/>
                    <Setter Property="Foreground" Value="#0F1822"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ResultBoxStyle" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#161C25"/>
            <Setter Property="BorderBrush" Value="#3D90C8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

    </Window.Resources>

    <ScrollViewer x:Name="MainScrollViewer"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource HeaderGradient}"
                    CornerRadius="22"
                    Padding="26"
                    Effect="{StaticResource PanelShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="DATA CENTER PLANNER"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Rack planning, server sizing, and topology overview for Data Center"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#18202B"
                            BorderBrush="#3E9EE0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,8"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="CURRENT BUILD"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="BuildVersionTextBlock"
                                       Text="v0.0.0"
                                       Foreground="{StaticResource AccentBrushSoft}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Input Parameters"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Grid.Row="1"
                                   Text="Choose a planning mode and enter the requested IOPS for each server family."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Planning Mode"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="PlanningModeComboBox"
                                SelectedIndex="0"
                                Style="{StaticResource ModernComboBoxStyle}"
                                ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}">
                                <ComboBoxItem Content="Balanced Racks"/>
                                <ComboBoxItem Content="Minimum Racks"/>
                            </ComboBox>
                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Network Planning"
                                        Foreground="{StaticResource AccentBrushSoft}"
                                        FontWeight="Bold"
                                        Margin="0,0,0,8"/>
                                    <CheckBox x:Name="RedundancyCheckBox"
                                        Content="Plan with redundancy"
                                        Style="{StaticResource ModernCheckBoxStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Allowed Server Types"
                                        Foreground="{StaticResource AccentBrushSoft}"
                                        FontWeight="Bold"
                                        Margin="0,0,0,8"/>
                                    <CheckBox x:Name="Allow12kServersCheckBox"
                                        Content="Allow 12k Server"
                                        IsChecked="True"
                                        Style="{StaticResource ModernCheckBoxStyle}"
                                        Margin="0,0,0,6"/>

                                    <CheckBox x:Name="Allow5kServersCheckBox"
                                        Content="Allow 5k Server"
                                        IsChecked="True"
                                        Style="{StaticResource ModernCheckBoxStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#202734" BorderBrush="#6B5830" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SystemX IOPS"
                                               Foreground="{StaticResource SystemXBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="SystemXIopsTextBox"
                                             Margin="0"
                                             Text="100000"
                                             BorderBrush="{StaticResource SystemXBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734" BorderBrush="#2E5E85" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="RISC IOPS"
                                               Foreground="{StaticResource RiscBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="RiscIopsTextBox"
                                             Margin="0"
                                             Text="50000"
                                             BorderBrush="{StaticResource RiscBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734" BorderBrush="#7050A8" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Mainframe IOPS"
                                               Foreground="{StaticResource MainframeBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="MainframeIopsTextBox"
                                             Margin="0"
                                             Text="50000"
                                             BorderBrush="{StaticResource MainframeBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734" BorderBrush="#2F8A5E" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="GPU IOPS"
                                               Foreground="{StaticResource GpuBrush}"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>
                                    <TextBox x:Name="GpuIopsTextBox"
                                             Margin="0"
                                             Text="40000"
                                             BorderBrush="{StaticResource GpuBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="4"
                                x:Name="CalculateButton"
                                Content="Calculate Plan"
                                Click="CalculateButton_Click"/>

                        <Border Grid.Row="6"
                                Margin="0,18,0,0"
                                Background="{StaticResource PanelBrushSecondary}"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Hardware Baseline"
                                           Foreground="{StaticResource AccentBrushSoft}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Rack: 47U"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="Switch: 1U"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="12k Server: 7U"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="5k Server: 3U"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="Global Main Rack: exactly 1 extra switch"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                            Text="Planning Result"
                            Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Grid.Row="1"
                            Text="Calculated rack layout, server count, and switch distribution"
                            Foreground="{StaticResource MutedTextBrush}"
                            Margin="0,0,0,6"/>

                        <!-- Summary Cards -->
                        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,0">
                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total Racks"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"/>
                                    <TextBlock Text="{Binding TotalRacks, Mode=OneWay}"
                                        Foreground="{StaticResource AccentBrushSoft}"
                                        FontSize="24"
                                        FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total Switches"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"/>
                                    <TextBlock Text="{Binding TotalSwitches, Mode=OneWay}"
                                        Foreground="{StaticResource AccentBrushSoft}"
                                        FontSize="24"
                                        FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Target IOPS"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"/>
                                    <TextBlock Text="{Binding TotalTargetIops, Mode=OneWay, StringFormat={}{0:N0}}"
                                        Foreground="{StaticResource AccentBrushSoft}"
                                        FontSize="24"
                                        FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Global Main Rack"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"/>
                                    <TextBlock Text="{Binding GlobalMainRackText, Mode=OneWay}"
                                        Foreground="{StaticResource AccentBrushSoft}"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Rack Switches"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"/>
                                    <TextBlock Text="{Binding Network.RackSwitchCount, Mode=OneWay}"
                                        Foreground="#4AAEFF"
                                        FontSize="24"
                                        FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="QSFP Modules"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"/>
                                    <TextBlock Text="{Binding Network.QsfpModuleCount, Mode=OneWay}"
                                        Foreground="#57D68D"
                                        FontSize="24"
                                        FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="QSFP Packs"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"/>
                                    <TextBlock Text="{Binding Network.QsfpPackCount, Mode=OneWay}"
                                        Foreground="#F2C94C"
                                        FontSize="24"
                                        FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#202734"
                                BorderBrush="#35516A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="RJ45 SFP Packs"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"/>
                                    <TextBlock Text="{Binding Network.Rj45SfpPackCount, Mode=OneWay}"
                                        Foreground="#F2994A"
                                        FontSize="24"
                                        FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Category Cards -->
                        <ScrollViewer Grid.Row="5"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="ResultScrollViewer_PreviewMouseWheel">
                            
                            
                            <ItemsControl ItemsSource="{Binding CategoryCards, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#202734"
                                            BorderBrush="{Binding AccentColorHex, Mode=OneWay}"
                                            BorderThickness="1.5"
                                            CornerRadius="14"
                                            Padding="16"
                                             Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Category, Mode=OneWay}"
                                                    Foreground="{Binding AccentColorHex, Mode=OneTime}"
                                                    FontSize="20"
                                                    FontWeight="Bold"/>

                                                <WrapPanel Margin="0,10,0,14">
                                                    <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <TextBlock Text="Racks" Foreground="#8AA4B8" FontSize="11"/>
                                                            <TextBlock Text="{Binding RackCount, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <TextBlock Text="12k Servers" Foreground="#8AA4B8" FontSize="11"/>
                                                            <TextBlock Text="{Binding Total12kServers, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <TextBlock Text="5k Servers" Foreground="#8AA4B8" FontSize="11"/>
                                                            <TextBlock Text="{Binding Total5kServers, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <TextBlock Text="Switches" Foreground="#8AA4B8" FontSize="11"/>
                                                            <TextBlock Text="{Binding TotalSwitches, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#1A212C" CornerRadius="10" Padding="10,6" Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <TextBlock Text="Planned IOPS" Foreground="#8AA4B8" FontSize="11"/>
                                                            <TextBlock Text="{Binding PlannedIops, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>

                                                <ItemsControl ItemsSource="{Binding Racks, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#161C25"
                                                                CornerRadius="10"
                                                                Padding="12"
                                                                Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="10"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <Grid Grid.Row="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel>
                                                                            <TextBlock FontWeight="Bold" Foreground="White">
                                                                                <Run Text="Rack "/>
                                                                                <Run Text="{Binding RackNumber, Mode=OneWay}"/>
                                                                                <Run Text="{Binding MainRackLabel, Mode=OneWay}"/>
                                                                            </TextBlock>

                                                                            <TextBlock Foreground="#B8D4EA" Margin="0,4,0,0">
                                                                                <Run Text="{Binding Count12kServers, Mode=OneWay}"/>
                                                                                <Run Text=" x 12k, "/>
                                                                                <Run Text="{Binding Count5kServers, Mode=OneWay}"/>
                                                                                <Run Text=" x 5k, "/>
                                                                                <Run Text="{Binding TotalDisplayedSwitches, Mode=OneWay}"/>
                                                                                <Run Text=" switch(es)"/>
                                                                            </TextBlock>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                            <TextBlock Text="{Binding TotalIops, Mode=OneWay, StringFormat={}{0:N0} IOPS}"
                                                                                Foreground="White"
                                                                                FontWeight="Bold"
                                                                                HorizontalAlignment="Right"/>
                                                                            <TextBlock Foreground="#8AA4B8"
                                                                                HorizontalAlignment="Right">
                                                                                <Run Text="{Binding UsedUnits, Mode=OneWay}"/>
                                                                                <Run Text="/47U used, "/>
                                                                                <Run Text="{Binding FreeUnits, Mode=OneWay}"/>
                                                                                <Run Text="U free"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <Grid Grid.Row="2" Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="230"/>
                                                                            <ColumnDefinition Width="12"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Background bar -->
                                                                        <Border Grid.Column="0"
                                                                            Height="12"
                                                                            Background="#0E141C"
                                                                            BorderBrush="#263445"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            VerticalAlignment="Center">
                                                                            <Grid>
                                                                                <Border HorizontalAlignment="Left"
                                                                                    Width="{Binding UsageBarWidth, Mode=OneWay}"
                                                                                    Background="{Binding AccentColorHex, Mode=OneWay}"
                                                                                    CornerRadius="6"
                                                                                    Height="12"/>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Percentage text -->
                                                                        <TextBlock Grid.Column="2"
                                                                        Text="{Binding UsagePercentText, Mode=OneWay}"
                                                                        Foreground="{Binding AccentColorHex, Mode=OneWay}"
                                                                        FontWeight="SemiBold"
                                                                        VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Grid.Row="7"
                            Background="#202734"
                            BorderBrush="#35516A"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Shopping Summary"
                                    Foreground="{StaticResource AccentBrushSoft}"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Margin="0,0,0,12"/>

                                <UniformGrid Columns="4">
                                    <Border Background="#1A212C"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Compute Cost"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                FontSize="12"/>
                                            <TextBlock Text="{Binding Shopping.ComputeCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                                Foreground="#F2C94C"
                                                FontSize="22"
                                                FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1A212C"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Infrastructure Cost"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                FontSize="12"/>
                                            <TextBlock Text="{Binding Shopping.InfrastructureCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                                Foreground="#4AAEFF"
                                                FontSize="22"
                                                FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1A212C"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Module Cost"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                FontSize="12"/>
                                            <TextBlock Text="{Binding Shopping.ModuleCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                                Foreground="#57D68D"
                                                FontSize="22"
                                                FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1A212C"
                                        CornerRadius="10"
                                        Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Total Cost"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                FontSize="12"/>
                                            <TextBlock Text="{Binding Shopping.TotalCost, Mode=OneWay, StringFormat={}{0:N0}$}"
                                                Foreground="{StaticResource AccentBrushSoft}"
                                                FontSize="22"
                                                FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Background="#202734"
                    CornerRadius="12"
                    Padding="12,8">
                <DockPanel>
                    <TextBlock Text="Inspired by the Data Center in-game color palette"
                               Foreground="{StaticResource MutedTextBrush}"
                               DockPanel.Dock="Left"/>

                    <TextBlock Text="WPF Prototype"
                               Foreground="{StaticResource AccentBrushSoft}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>